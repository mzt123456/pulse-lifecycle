# 应用
APP_NAME=某能源装备企业维保管理系统
APP_VERSION=3.0.0
APP_ENV=dev
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# 数据库：开发库是容器里的 MySQL 8.0，映射到宿主机 3307
DATABASE_URL=mysql+pymysql://pulse_dev:dev_pwd@127.0.0.1:3307/pulse_lifecycle_dev?charset=utf8mb4
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
DB_ECHO=false

# 跨域白名单，多个用逗号分隔；留空表示不启用
CORS_ORIGINS=

# 认证与令牌：生产环境必须由环境变量提供 PULSE_JWT_SECRET，不要用默认值
PULSE_JWT_SECRET=dev-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_SECONDS=300
LOGIN_RATE_LIMIT_PER_MINUTE=10

# 初始化管理员口令：只在执行种子脚本时使用，部署后请立即修改
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=

# 工单号前缀，生成规则为 前缀 + 年月日 + 三位序号
MAINTENANCE_ORDER_PREFIX=WX

# 智能运维助手：生成层用 OpenAI 兼容协议，默认指向 DeepSeek
# Key 留空时诊断接口不报错，自动降级为只返回检索到的相似案例
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# 检索：返回条数上限；仿真案例在真实故障数据迁移到位后可关掉
AI_TOP_K=5
AI_INCLUDE_SYNTHETIC=true

# 相关性重排：用对话模型过滤"字面撞词但语义无关"的候选
AI_RERANK=true
AI_RERANK_MIN_SCORE=5

# 向量检索：none 只用关键词（默认）；api 走 OpenAI 兼容的 /embeddings；local 用本地 BGE
# 通义示例：EMBEDDING_PROVIDER=api + DASHSCOPE_API_KEY
# 模型选 qwen3.7-text-embedding（多语言统一向量，256~2560 维可自定义）；
# 同源的 text-embedding-v4 也兼容，改这一行即可
EMBEDDING_PROVIDER=none
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=qwen3.7-text-embedding
# 维度：模型支持 256~2560。几千条语料 1024 维足够，维数越高精度略好、存储与延迟也越高
EMBEDDING_DIMENSIONS=1024
# 本地 BGE 时把提供方改成 local，模型名例如 BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=
