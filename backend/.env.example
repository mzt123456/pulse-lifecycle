# 应用
APP_NAME=某能源装备企业维保管理系统
APP_VERSION=3.0.0
APP_ENV=dev
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# 数据库：开发库是容器里的 MySQL 8.0，映射到宿主机 3307
DATABASE_URL=mysql+pymysql://pulse_dev:dev_pwd@127.0.0.1:3307/pulse_lifecycle_dev?charset=utf8mb4
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
DB_ECHO=false

# 跨域白名单，多个用逗号分隔；留空表示不启用
CORS_ORIGINS=

# 认证与令牌：生产环境必须由环境变量提供 PULSE_JWT_SECRET，不要用默认值
PULSE_JWT_SECRET=dev-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_SECONDS=300
LOGIN_RATE_LIMIT_PER_MINUTE=10

# 初始化管理员口令：只在执行种子脚本时使用，部署后请立即修改
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=

# 工单号前缀，生成规则为 前缀 + 年月日 + 三位序号
MAINTENANCE_ORDER_PREFIX=WX
